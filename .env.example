# ==========================================
# FrameBatch (mec-recaps) - Configurações de Ambiente
# ==========================================

# Porta onde o servidor da aplicação roda (desenvolvimento e preview)
PORT=3000
VITE_PORT=3000

# URL do endpoint compatível com OpenAI (ex: 9router, Local LLM, LM Studio, Ollama)
VITE_AI_BASE_URL=http://localhost:20128/v1

# Chave de API do provedor (opcional se o servidor local não exigir)
VITE_AI_API_KEY=

# Modelo padrão de visão e roteirização
VITE_AI_MODEL=ag/gemini-3.8-flash-high

# Voz padrão para Text-to-Speech (Edge-TTS via 9router)
VITE_AI_TTS_MODEL=edge-tts/pt-BR-AntonioNeural
